\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \textbf  {RQ3: the three findings across eight models and four lineages}, all read from one evaluation phase. $\surd  $\ replicated, $\circ $ inconclusive, $\times $ refuted. R1 is breadth's unseen-family tax (\texttt  {mono\_all} $-$ \texttt  {tuned\_L0} on the held-out family); R2 is anchoring removing it (\texttt  {cons\_lam3} $-$ \texttt  {mono\_all}); R3 is anchoring's clean-code cost (\texttt  {cons\_lam3} $-$ \texttt  {tuned\_L0} on clean code). Bold intervals exclude zero.}}{12}{table.caption.10}\protected@file@percent }
\newlabel{tab:rq3_panel}{{10}{12}{\textbf {RQ3: the three findings across eight models and four lineages}, all read from one evaluation phase. $\surd $\ replicated, $\circ $ inconclusive, $\times $ refuted. R1 is breadth's unseen-family tax (\texttt {mono\_all} $-$ \texttt {tuned\_L0} on the held-out family); R2 is anchoring removing it (\texttt {cons\_lam3} $-$ \texttt {mono\_all}); R3 is anchoring's clean-code cost (\texttt {cons\_lam3} $-$ \texttt {tuned\_L0} on clean code). Bold intervals exclude zero}{table.caption.10}{}}
