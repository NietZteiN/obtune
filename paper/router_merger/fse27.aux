\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}The composition test}{6}{subsection.5.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Single transforms.} Each is applied to the clean parent and never stacked. \emph  {Cap} is the maximum growth factor over the parent above which a program is declined rather than clipped; \emph  {programs / items} is held-out coverage. H1 is the quarantined held-out obfuscator whose evaluation budget is spent; X1 is its trainable sibling and carries every unseen-family number.}}{7}{table.caption.3}\protected@file@percent }
\newlabel{tab:taxonomy}{{3}{7}{\textbf {Single transforms.} Each is applied to the clean parent and never stacked. \emph {Cap} is the maximum growth factor over the parent above which a program is declined rather than clipped; \emph {programs / items} is held-out coverage. H1 is the quarantined held-out obfuscator whose evaluation budget is spent; X1 is its trainable sibling and carries every unseen-family number}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Stacked composites.} A separate namespace from the ladder: parts are applied to the clean parent left to right, and order matters because composition does not commute. Size caps were calibrated on a 40-program build at cap 60 (p95 $\times $ 1.25) so that the cap is never the binding constraint. No system is ever trained on a stack; the breadth and family adapters see single transforms only.}}{8}{table.caption.4}\protected@file@percent }
\newlabel{tab:stacks}{{4}{8}{\textbf {Stacked composites.} A separate namespace from the ladder: parts are applied to the clean parent left to right, and order matters because composition does not commute. Size caps were calibrated on a 40-program build at cap 60 (p95 $\times $ 1.25) so that the cap is never the binding constraint. No system is ever trained on a stack; the breadth and family adapters see single transforms only}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {RQ1: routing and merging on stacks of seen transforms.} Paired differences in points on the ten stacks (six depth-2, four depth-3/4), CodeLlama-7B, 394 programs common to every cell. Routing is worth about a point over a random gate and nothing over breadth; the mixture itself carries the gain (\texttt  {mole\_uniform} $-$ \texttt  {base}); a hard argmax router is indistinguishable from the soft one. The best merge (DARE-TIES) matches the clean-code control and the other four fall below it. Bold intervals exclude zero. Every arm ran through the mixture engine (\texttt  {obtune.mole.eval\_mole}); an earlier run through vLLM had written the untuned model under the routing arms' names and was withdrawn.}}{9}{table.caption.5}\protected@file@percent }
\newlabel{tab:rq1_composition}{{5}{9}{\textbf {RQ1: routing and merging on stacks of seen transforms.} Paired differences in points on the ten stacks (six depth-2, four depth-3/4), CodeLlama-7B, 394 programs common to every cell. Routing is worth about a point over a random gate and nothing over breadth; the mixture itself carries the gain (\texttt {mole\_uniform} $-$ \texttt {base}); a hard argmax router is indistinguishable from the soft one. The best merge (DARE-TIES) matches the clean-code control and the other four fall below it. Bold intervals exclude zero. Every arm ran through the mixture engine (\texttt {obtune.mole.eval\_mole}); an earlier run through vLLM had written the untuned model under the routing arms' names and was withdrawn}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Weight-space merging on the panel.} The best merge (DARE-TIES of the clean adapter and the five specialists) against the clean-code control, breadth and the anchored objective, pooled over the six seen stacks and the four stacks containing the unseen family; breadth and anchoring against the control in the last two columns. Points, paired on the programs common to every cell, program-clustered bootstrap. Bold intervals exclude zero. Pre-registered per model: merging does not beat the control on seen stacks (CONFIRMED iff $\mathrm  {ci}_{hi} \le +1$) and stays below breadth ($\mathrm  {ci}_{hi} < 0$).}}{9}{table.caption.6}\protected@file@percent }
\newlabel{tab:rq1_merge_panel}{{6}{9}{\textbf {Weight-space merging on the panel.} The best merge (DARE-TIES of the clean adapter and the five specialists) against the clean-code control, breadth and the anchored objective, pooled over the six seen stacks and the four stacks containing the unseen family; breadth and anchoring against the control in the last two columns. Points, paired on the programs common to every cell, program-clustered bootstrap. Bold intervals exclude zero. Pre-registered per model: merging does not beat the control on seen stacks (CONFIRMED iff $\mathrm {ci}_{hi} \le +1$) and stays below breadth ($\mathrm {ci}_{hi} < 0$)}{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The reversal test}{9}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {RQ1: the dissociation, measured within model on one program set.} Breadth (\texttt  {mono\_all}) against the clean-code control (\texttt  {tuned\_L0}) on stacks built from \emph  {seen} transforms and on stacks containing an \emph  {unseen} family. The \emph  {difference} is the measured quantity; the two levels are context, and on most models the unseen-side interval straddles zero on its own. Both halves are paired on the 319 programs common to every cell of both groups. Bold intervals exclude zero.}}{10}{table.caption.7}\protected@file@percent }
\newlabel{tab:rq1_dissociation}{{7}{10}{\textbf {RQ1: the dissociation, measured within model on one program set.} Breadth (\texttt {mono\_all}) against the clean-code control (\texttt {tuned\_L0}) on stacks built from \emph {seen} transforms and on stacks containing an \emph {unseen} family. The \emph {difference} is the measured quantity; the two levels are context, and on most models the unseen-side interval straddles zero on its own. Both halves are paired on the 319 programs common to every cell of both groups. Bold intervals exclude zero}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {The direction ratio: how much of a forward gain survives the task being run backwards.} Forward is output prediction; backward is input prediction on the same programs, graded by execution. No adapter is trained on the backward task, so any backward gain is transferred program understanding rather than task fitting. $\mathrm  {DR} < 0$ means the arm bought forward accuracy by \emph  {losing} backward competence. Every adaptation method that fits the forward task directly is negative; only anchoring and family exposure are not. Both directions use the same 412 programs and the same six conditions. Bold intervals exclude zero; the ratio is descriptive and is read with its components.}}{10}{table.caption.8}\protected@file@percent }
\newlabel{tab:direction_ratio}{{8}{10}{\textbf {The direction ratio: how much of a forward gain survives the task being run backwards.} Forward is output prediction; backward is input prediction on the same programs, graded by execution. No adapter is trained on the backward task, so any backward gain is transferred program understanding rather than task fitting. $\mathrm {DR} < 0$ means the arm bought forward accuracy by \emph {losing} backward competence. Every adaptation method that fits the forward task directly is negative; only anchoring and family exposure are not. Both directions use the same 412 programs and the same six conditions. Bold intervals exclude zero; the ratio is descriptive and is read with its components}{table.caption.8}{}}
