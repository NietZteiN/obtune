\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The dataset.} One Python corpus, split by program so no obfuscated variant of a training program can reach evaluation.}}{5}{table.caption.2}\protected@file@percent }
