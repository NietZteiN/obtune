\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}On seen compositions, every adaptation works}{7}{subsection.3.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Every adaptation on every model, in the three regimes that separate them.} Mean exact-match accuracy over the conditions in each block, equally weighted; the same numbers as the bold rows of the per-model tables in Appendix\nonbreakingspace \ref {app:absmaster}. \emph  {seen stacks}: depth-2/3/4 compositions of the seen transforms; seven of its ten conditions include \texttt  {S3} or \texttt  {S4}, which the mixture has experts for and \emph  {breadth} and \emph  {merge} do not. --- no arm was trained on it. \emph  {backward}: input prediction, graded by execution. \emph  {base} is the untuned model, \emph  {clean} a LoRA tuned on unobfuscated code, \emph  {breadth} one LoRA tuned on all six training conditions at once, \emph  {anch} the paired-consistency objective, \emph  {mix} a learned-gate mixture of eight per-condition specialists, \emph  {merge} the DARE-TIES merge of the six that breadth pools. \emph  {breadth} and \emph  {merge} are exactly data-matched; \emph  {mix} carries two further experts (\texttt  {S3}, \texttt  {S4}) that neither is trained on. \textbf  {Bold} is the best non-base arm in that block; \textcolor {red!70!black}{red} is below \texttt  {base}. `--': no cell in the block survived the 0.25 format gate. \textbf  {Read the bold across the blocks}: on seen stacks it falls on the single-adapter arms, and on the two out-of-distribution blocks it moves to the arms composed from per-transform specialists.}}{8}{table.caption.5}\protected@file@percent }
\newlabel{tab:main}{{5}{8}{\textbf {Every adaptation on every model, in the three regimes that separate them.} Mean exact-match accuracy over the conditions in each block, equally weighted; the same numbers as the bold rows of the per-model tables in Appendix~\ref {app:absmaster}. \emph {seen stacks}: depth-2/3/4 compositions of the seen transforms; seven of its ten conditions include \texttt {S3} or \texttt {S4}, which the mixture has experts for and \emph {breadth} and \emph {merge} do not. --- no arm was trained on it. \emph {backward}: input prediction, graded by execution. \emph {base} is the untuned model, \emph {clean} a LoRA tuned on unobfuscated code, \emph {breadth} one LoRA tuned on all six training conditions at once, \emph {anch} the paired-consistency objective, \emph {mix} a learned-gate mixture of eight per-condition specialists, \emph {merge} the DARE-TIES merge of the six that breadth pools. \emph {breadth} and \emph {merge} are exactly data-matched; \emph {mix} carries two further experts (\texttt {S3}, \texttt {S4}) that neither is trained on. \textbf {Bold} is the best non-base arm in that block; \textcolor {red!70!black}{red} is below \texttt {base}. `--': no cell in the block survived the 0.25 format gate. \textbf {Read the bold across the blocks}: on seen stacks it falls on the single-adapter arms, and on the two out-of-distribution blocks it moves to the arms composed from per-transform specialists}{table.caption.5}{}}
