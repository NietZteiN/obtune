\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces \textbf  {Merge variants against the untuned model, CodeLlama-7B.} Each cell is \emph  {output prediction}\,/\,\emph  {input prediction}, raw exact-match accuracy; backward is graded by execution. The three merges combine the same six specialists with the same uniform weights, density $0.5$ and sign rule, and differ only in the sparsification step: \emph  {TIES} keeps the largest entries by magnitude (Eq.\nonbreakingspace \ref {eq:trim}), \emph  {DARE-TIES} drops entries at random and rescales (Eq.\nonbreakingspace \ref {eq:dare}), and \emph  {DARE-linear} applies that drop without the sign election of Eq.\nonbreakingspace \ref {eq:elect}. \textbf  {Colour}: \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt  {base} in the same direction; a red number carrying a dagger is gated instead (format-failure rate above 0.25). \textbf  {Bold rows} are group means. \emph  {DARE-linear} was run forward only, so its backward half is absent by construction rather than by omission.}}{33}{table.caption.25}\protected@file@percent }
\newlabel{tab:merge_variants_codellama7b}{{14}{33}{\textbf {Merge variants against the untuned model, CodeLlama-7B.} Each cell is \emph {output prediction}\,/\,\emph {input prediction}, raw exact-match accuracy; backward is graded by execution. The three merges combine the same six specialists with the same uniform weights, density $0.5$ and sign rule, and differ only in the sparsification step: \emph {TIES} keeps the largest entries by magnitude (Eq.~\ref {eq:trim}), \emph {DARE-TIES} drops entries at random and rescales (Eq.~\ref {eq:dare}), and \emph {DARE-linear} applies that drop without the sign election of Eq.~\ref {eq:elect}. \textbf {Colour}: \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt {base} in the same direction; a red number carrying a dagger is gated instead (format-failure rate above 0.25). \textbf {Bold rows} are group means. \emph {DARE-linear} was run forward only, so its backward half is absent by construction rather than by omission}{table.caption.25}{}}
