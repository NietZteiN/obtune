\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Single transforms.} Each is applied to the clean parent and never stacked. \emph  {Cap} is the maximum growth factor over the parent above which a program is declined rather than clipped; \emph  {programs / items} is held-out coverage. H1 is the quarantined held-out obfuscator whose evaluation budget is spent; X1 is its trainable sibling and carries every unseen-family number.}}{6}{table.caption.3}\protected@file@percent }
\newlabel{tab:taxonomy}{{3}{6}{\textbf {Single transforms.} Each is applied to the clean parent and never stacked. \emph {Cap} is the maximum growth factor over the parent above which a program is declined rather than clipped; \emph {programs / items} is held-out coverage. H1 is the quarantined held-out obfuscator whose evaluation budget is spent; X1 is its trainable sibling and carries every unseen-family number}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Measurement}{6}{subsection.3.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Stacked composites.} A separate namespace from the ladder: parts are applied to the clean parent left to right, and order matters because composition does not commute. Size caps were calibrated on a 40-program build at cap 60 (p95 $\times $ 1.25) so that the cap is never the binding constraint. No system is ever trained on a stack; the breadth and family adapters see single transforms only.}}{7}{table.caption.4}\protected@file@percent }
\newlabel{tab:stacks}{{4}{7}{\textbf {Stacked composites.} A separate namespace from the ladder: parts are applied to the clean parent left to right, and order matters because composition does not commute. Size caps were calibrated on a 40-program build at cap 60 (p95 $\times $ 1.25) so that the cap is never the binding constraint. No system is ever trained on a stack; the breadth and family adapters see single transforms only}{table.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Every method against every obfuscation}{7}{section.4}\protected@file@percent }
\newlabel{sec:master}{{4}{7}{Every method against every obfuscation}{section.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}RQ1: Do current adaptation methods generalise?}{8}{section.5}\protected@file@percent }
\newlabel{sec:rq1}{{5}{8}{RQ1: Do current adaptation methods generalise?}{section.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Every method against every obfuscation, CodeLlama-7B.} Raw accuracy (strict exact match), with \%\,\emph  {b} after each system: its accuracy as a percentage of \texttt  {base}'s on the same condition. \emph  {base} is the untuned model; \emph  {ICL} its one-shot prompt; \emph  {clean LoRA} is tuned on unobfuscated code; \emph  {breadth} on all five seen transforms; \emph  {anchored} is the paired-consistency objective; \emph  {family} is trained on the unseen family's sibling; \emph  {mixture} is the learned-gate mixture of per-transform specialists; \emph  {merge} is the DARE-TIES merge of them (keys in order: \texttt  {base}, \texttt  {base\_1shot}, \texttt  {tuned\_L0}, \texttt  {mono\_all}, \texttt  {cons\_lam3}, \texttt  {tuned\_X1}, \texttt  {mole\_router}, \texttt  {merge\_dare\_ties}). \textbf  {The backward block is reported twice.} \emph  {by execution} accepts any call that returns the gold value, and inversion is many-to-one, so a guess that lands on a common return value scores; \emph  {by exact arguments} requires the gold call. Measured on CodeLlama-7B, 64--69\,\% of every system's backward successes are of the first kind, which is why the untuned model appears to read backwards almost as well as forwards. $\dagger  $: format-failure rate above 0.25. `--': not run.}}{9}{table.caption.5}\protected@file@percent }
\newlabel{tab:master_abs_codellama7b}{{5}{9}{\textbf {Every method against every obfuscation, CodeLlama-7B.} Raw accuracy (strict exact match), with \%\,\emph {b} after each system: its accuracy as a percentage of \texttt {base}'s on the same condition. \emph {base} is the untuned model; \emph {ICL} its one-shot prompt; \emph {clean LoRA} is tuned on unobfuscated code; \emph {breadth} on all five seen transforms; \emph {anchored} is the paired-consistency objective; \emph {family} is trained on the unseen family's sibling; \emph {mixture} is the learned-gate mixture of per-transform specialists; \emph {merge} is the DARE-TIES merge of them (keys in order: \texttt {base}, \texttt {base\_1shot}, \texttt {tuned\_L0}, \texttt {mono\_all}, \texttt {cons\_lam3}, \texttt {tuned\_X1}, \texttt {mole\_router}, \texttt {merge\_dare\_ties}). \textbf {The backward block is reported twice.} \emph {by execution} accepts any call that returns the gold value, and inversion is many-to-one, so a guess that lands on a common return value scores; \emph {by exact arguments} requires the gold call. Measured on CodeLlama-7B, 64--69\,\% of every system's backward successes are of the first kind, which is why the untuned model appears to read backwards almost as well as forwards. $\dagger $: format-failure rate above 0.25. `--': not run}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {RQ1: the dissociation, measured within model on one program set.} Breadth (\texttt  {mono\_all}) against the clean-code control (\texttt  {tuned\_L0}) on stacks built from \emph  {seen} transforms and on stacks containing an \emph  {unseen} family. The \emph  {difference} is the measured quantity; the two levels are context, and on most models the unseen-side interval straddles zero on its own. Both halves are paired on the 319 programs common to every cell of both groups. Bold intervals exclude zero.}}{10}{table.caption.6}\protected@file@percent }
\newlabel{tab:rq1_dissociation}{{6}{10}{\textbf {RQ1: the dissociation, measured within model on one program set.} Breadth (\texttt {mono\_all}) against the clean-code control (\texttt {tuned\_L0}) on stacks built from \emph {seen} transforms and on stacks containing an \emph {unseen} family. The \emph {difference} is the measured quantity; the two levels are context, and on most models the unseen-side interval straddles zero on its own. Both halves are paired on the 319 programs common to every cell of both groups. Bold intervals exclude zero}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {RQ2: breadth's stack gain depends on an identifier transform being present.} Breadth over the clean-code control, split by whether the stack contains an identifier transform, with the \emph  {difference} between the groups. The rule defining the split was fixed before the unseen-containing stimulus existed, which makes the second row an out-of-sample test of it. We report the difference because one interval excluding zero while another does not is not a test of the difference between them.}}{10}{table.caption.7}\protected@file@percent }
\newlabel{tab:rq2_identifier}{{7}{10}{\textbf {RQ2: breadth's stack gain depends on an identifier transform being present.} Breadth over the clean-code control, split by whether the stack contains an identifier transform, with the \emph {difference} between the groups. The rule defining the split was fixed before the unseen-containing stimulus existed, which makes the second row an out-of-sample test of it. We report the difference because one interval excluding zero while another does not is not a test of the difference between them}{table.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}RQ2: Anchoring to clean-code behaviour}{10}{section.6}\protected@file@percent }
\newlabel{sec:loss}{{6}{10}{RQ2: Anchoring to clean-code behaviour}{section.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {RQ3: the three findings across eight models and four lineages}, all read from one evaluation phase. $\surd  $\ replicated, $\circ $ inconclusive, $\times $ refuted. R1 is breadth's unseen-family tax (\texttt  {mono\_all} $-$ \texttt  {tuned\_L0} on the held-out family); R2 is anchoring removing it (\texttt  {cons\_lam3} $-$ \texttt  {mono\_all}); R3 is anchoring's clean-code cost (\texttt  {cons\_lam3} $-$ \texttt  {tuned\_L0} on clean code). Bold intervals exclude zero.}}{11}{table.caption.8}\protected@file@percent }
\newlabel{tab:rq3_panel}{{8}{11}{\textbf {RQ3: the three findings across eight models and four lineages}, all read from one evaluation phase. $\surd $\ replicated, $\circ $ inconclusive, $\times $ refuted. R1 is breadth's unseen-family tax (\texttt {mono\_all} $-$ \texttt {tuned\_L0} on the held-out family); R2 is anchoring removing it (\texttt {cons\_lam3} $-$ \texttt {mono\_all}); R3 is anchoring's clean-code cost (\texttt {cons\_lam3} $-$ \texttt {tuned\_L0} on clean code). Bold intervals exclude zero}{table.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}RQ3: Does the anchored model survive the same tests?}{11}{section.7}\protected@file@percent }
\newlabel{sec:stress}{{7}{11}{RQ3: Does the anchored model survive the same tests?}{section.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {RQ4: the divergence ladder.} Composites that contain a transform family the model has never seen. Breadth's advantage flips sign the moment such a component enters, while anchoring rises \emph  {above} the clean-code control. The pre-registered rule required both that anchoring hold and that breadth fall below the control; only the first is established, since the pooled interval at d2 straddles zero. CodeLlama-7B, 287 programs common to all six composites, fixed before any system was evaluated.}}{12}{table.caption.9}\protected@file@percent }
\newlabel{tab:rq4_ladder}{{9}{12}{\textbf {RQ4: the divergence ladder.} Composites that contain a transform family the model has never seen. Breadth's advantage flips sign the moment such a component enters, while anchoring rises \emph {above} the clean-code control. The pre-registered rule required both that anchoring hold and that breadth fall below the control; only the first is established, since the pooled interval at d2 straddles zero. CodeLlama-7B, 287 programs common to all six composites, fixed before any system was evaluated}{table.caption.9}{}}
