\newlabel{tab:master_granite318b}{{21}{29}{\textbf {Master grid, Granite-3.1-8B.} Every condition and every stack, forward (output prediction) and backward (input prediction). Per system: \emph {acc} raw accuracy; $\Delta $ points against the untuned model on the same condition; \% accuracy as a percentage of the untuned model's clean-code accuracy in the same direction, i.e.\ how much of the original accuracy the system brings back (100 = the untuned model on clean code). \emph {fmt}: format-failure rate above 0.25, the cell measures the prompt contract rather than the task and enters no mean. Pooled rows average the stacks above them. `--': cell not run}{table.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces \textbf  {Routing, CodeLlama-7B.} MoLE mixtures of the eight per-transform experts on every condition and stack that has them: \emph  {router} = trained gate, \emph  {hard router} = its argmax, \emph  {uniform} = fixed uniform gate, \emph  {random} = gate frozen at random initialisation. Per system: raw accuracy, $\Delta $ points against the untuned model on the same items, and \% of the untuned model's clean-code accuracy. Every cell ran through the mixture engine.}}{30}{table.caption.24}\protected@file@percent }
\newlabel{tab:routing_codellama7b}{{22}{30}{\textbf {Routing, CodeLlama-7B.} MoLE mixtures of the eight per-transform experts on every condition and stack that has them: \emph {router} = trained gate, \emph {hard router} = its argmax, \emph {uniform} = fixed uniform gate, \emph {random} = gate frozen at random initialisation. Per system: raw accuracy, $\Delta $ points against the untuned model on the same items, and \% of the untuned model's clean-code accuracy. Every cell ran through the mixture engine}{table.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {23}{\ignorespaces \textbf  {Merging, CodeLlama-7B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid.}}{30}{table.caption.25}\protected@file@percent }
\newlabel{tab:merging_codellama7b}{{23}{30}{\textbf {Merging, CodeLlama-7B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid}{table.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {24}{\ignorespaces \textbf  {Merging, Granite-3.1-8B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid.}}{31}{table.caption.26}\protected@file@percent }
\newlabel{tab:merging_granite318b}{{24}{31}{\textbf {Merging, Granite-3.1-8B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid}{table.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces \textbf  {Merging, Llama-3.1-8B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid.}}{31}{table.caption.27}\protected@file@percent }
\newlabel{tab:merging_llama318b}{{25}{31}{\textbf {Merging, Llama-3.1-8B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid}{table.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {26}{\ignorespaces \textbf  {Merging, StarCoder2-15B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid.}}{32}{table.caption.28}\protected@file@percent }
\newlabel{tab:merging_starcoder215b}{{26}{32}{\textbf {Merging, StarCoder2-15B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid}{table.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {27}{\ignorespaces \textbf  {RQ1: routing and merging on stacks of seen transforms.} Paired differences in points on the ten stacks (six depth-2, four depth-3/4), CodeLlama-7B, 394 programs common to every cell; the last column repeats the contrasts on the four stacks that contain the unseen family (319 programs; merges other than DARE-TIES have no cells there). Routing is worth about a point over a random gate and nothing over breadth; the mixture itself carries the gain (\texttt  {mole\_uniform} $-$ \texttt  {base}); a hard argmax router is indistinguishable from the soft one. The best merge (DARE-TIES) matches the clean-code control and the other four fall below it. Bold intervals exclude zero. Every arm ran through the mixture engine (\texttt  {obtune.mole.eval\_mole}); an earlier run through vLLM had written the untuned model under the routing arms' names and was withdrawn.}}{32}{table.caption.29}\protected@file@percent }
\newlabel{tab:rq1_composition}{{27}{32}{\textbf {RQ1: routing and merging on stacks of seen transforms.} Paired differences in points on the ten stacks (six depth-2, four depth-3/4), CodeLlama-7B, 394 programs common to every cell; the last column repeats the contrasts on the four stacks that contain the unseen family (319 programs; merges other than DARE-TIES have no cells there). Routing is worth about a point over a random gate and nothing over breadth; the mixture itself carries the gain (\texttt {mole\_uniform} $-$ \texttt {base}); a hard argmax router is indistinguishable from the soft one. The best merge (DARE-TIES) matches the clean-code control and the other four fall below it. Bold intervals exclude zero. Every arm ran through the mixture engine (\texttt {obtune.mole.eval\_mole}); an earlier run through vLLM had written the untuned model under the routing arms' names and was withdrawn}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {28}{\ignorespaces \textbf  {Weight-space merging on the panel.} The best merge (DARE-TIES of the clean adapter and the five specialists) against the clean-code control, breadth and the anchored objective, pooled over the six seen stacks and the four stacks containing the unseen family; breadth and anchoring against the control in the last two columns. Points, paired on the programs common to every cell, program-clustered bootstrap. Bold intervals exclude zero. Pre-registered per model: merging does not beat the control on seen stacks (CONFIRMED iff $\mathrm  {ci}_{hi} \le +1$) and stays below breadth ($\mathrm  {ci}_{hi} < 0$).}}{33}{table.caption.30}\protected@file@percent }
\newlabel{tab:rq1_merge_panel}{{28}{33}{\textbf {Weight-space merging on the panel.} The best merge (DARE-TIES of the clean adapter and the five specialists) against the clean-code control, breadth and the anchored objective, pooled over the six seen stacks and the four stacks containing the unseen family; breadth and anchoring against the control in the last two columns. Points, paired on the programs common to every cell, program-clustered bootstrap. Bold intervals exclude zero. Pre-registered per model: merging does not beat the control on seen stacks (CONFIRMED iff $\mathrm {ci}_{hi} \le +1$) and stays below breadth ($\mathrm {ci}_{hi} < 0$)}{table.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {29}{\ignorespaces \textbf  {The direction ratio: how much of a forward gain survives the task being run backwards.} Forward is output prediction; backward is input prediction on the same programs, graded by execution. No adapter is trained on the backward task, so any backward gain is transferred program understanding rather than task fitting. $\mathrm  {DR} < 0$ means the arm bought forward accuracy by \emph  {losing} backward competence. Every adaptation method that fits the forward task directly is negative; only anchoring and family exposure are not. Both directions use the same 412 programs and the same six conditions. Bold intervals exclude zero; the ratio is descriptive and is read with its components.}}{33}{table.caption.31}\protected@file@percent }
\newlabel{tab:direction_ratio}{{29}{33}{\textbf {The direction ratio: how much of a forward gain survives the task being run backwards.} Forward is output prediction; backward is input prediction on the same programs, graded by execution. No adapter is trained on the backward task, so any backward gain is transferred program understanding rather than task fitting. $\mathrm {DR} < 0$ means the arm bought forward accuracy by \emph {losing} backward competence. Every adaptation method that fits the forward task directly is negative; only anchoring and family exposure are not. Both directions use the same 412 programs and the same six conditions. Bold intervals exclude zero; the ratio is descriptive and is read with its components}{table.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {30}{\ignorespaces \textbf  {RQ4: the divergence result across the panel}, on stacks containing the unseen family. \texttt  {cons}$-$\texttt  {mono} is anchoring's advantage over breadth; \texttt  {fam} is an arm trained on the unseen family's trainable sibling, included because family exposure is the largest effect in the table and replicates on every model. Bold intervals exclude zero.}}{34}{table.caption.32}\protected@file@percent }
\newlabel{tab:rq4_by_model}{{30}{34}{\textbf {RQ4: the divergence result across the panel}, on stacks containing the unseen family. \texttt {cons}$-$\texttt {mono} is anchoring's advantage over breadth; \texttt {fam} is an arm trained on the unseen family's trainable sibling, included because family exposure is the largest effect in the table and replicates on every model. Bold intervals exclude zero}{table.caption.32}{}}
\@writefile{lot}{\contentsline {table}{\numberline {31}{\ignorespaces \textbf  {Every intervention against every kind of obfuscation, across the eight-model panel.} For each system and direction, $\Delta $ is the mean change in points against the untuned model and \% the mean accuracy as a percentage of the untuned model's clean-code accuracy, over the cells that exist and pass the format gate (in parentheses: the number of cells; after the semicolon, the number gated as \emph  {fmt}). Systems: ICL = \texttt  {base\_1shot}, clean LoRA = \texttt  {tuned\_L0}, breadth = \texttt  {mono\_all}, anchored = \texttt  {cons\_lam3}, family = \texttt  {tuned\_X1}. \emph  {seen} = L1b, L1r, L2, S1, S2; \emph  {seen stacks} = the six depth-2 and four depth-3/4 stacks of seen transforms; \emph  {unseen stacks} = the three depth-2 and one depth-3 stacks with the X1 family inside. Backward cells survive the gate almost only on CodeLlama-7B, whose grid (Table\nonbreakingspace \ref {tab:master_codellama7b}) is the one fully interpretable backward read; the per-model grids for the whole panel are in Appendix\nonbreakingspace \ref {app:master}.}}{34}{table.caption.33}\protected@file@percent }
\newlabel{tab:master_summary}{{31}{34}{\textbf {Every intervention against every kind of obfuscation, across the eight-model panel.} For each system and direction, $\Delta $ is the mean change in points against the untuned model and \% the mean accuracy as a percentage of the untuned model's clean-code accuracy, over the cells that exist and pass the format gate (in parentheses: the number of cells; after the semicolon, the number gated as \emph {fmt}). Systems: ICL = \texttt {base\_1shot}, clean LoRA = \texttt {tuned\_L0}, breadth = \texttt {mono\_all}, anchored = \texttt {cons\_lam3}, family = \texttt {tuned\_X1}. \emph {seen} = L1b, L1r, L2, S1, S2; \emph {seen stacks} = the six depth-2 and four depth-3/4 stacks of seen transforms; \emph {unseen stacks} = the three depth-2 and one depth-3 stacks with the X1 family inside. Backward cells survive the gate almost only on CodeLlama-7B, whose grid (Table~\ref {tab:master_codellama7b}) is the one fully interpretable backward read; the per-model grids for the whole panel are in Appendix~\ref {app:master}}{table.caption.33}{}}
