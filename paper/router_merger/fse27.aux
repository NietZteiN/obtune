\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Every method against every obfuscation, CodeLlama-7B.} Each cell is \emph  {output prediction}\,/\,\emph  {input prediction}: raw exact-match accuracy on the forward task (predict the return value of the code as shown) and, after the slash, on the backward task (produce a call that returns the shown value), on the held-out programs of that condition. \emph  {base} is the untuned model; \emph  {ICL} its one-shot prompt; \emph  {clean LoRA} is tuned on unobfuscated code; \emph  {breadth} on all six training conditions pooled; \emph  {anchored} is the paired-consistency objective; \emph  {mixture} is the learned-gate mixture of per-transform specialists; \emph  {merge} is the DARE-TIES merge of them. \textbf  {Colour}: an accuracy \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt  {base} in the same direction on the same condition; \texttt  {base} is the reference, and an uncoloured number means no comparison was available rather than a tie. A \textcolor {red!70!black}{red number carrying $\dagger  $ or $\ddagger  $} is red for the other reason --- its format-failure rate is above 0.25, so the accuracy beneath it is not a fair reading of the arm --- and those cells are excluded from the bold means. \textbf  {Bold rows} are means over the group named, equally weighted per condition; a superscript gives the number of readable cells averaged when it is short of the group. The family adapter (\texttt  {tuned\_X1}) is deliberately not a column: it is trained on the held-out family's sibling, so on exactly the rows that matter most it is the one arm for which that family is not held out; the \textbf  {held-out family} row names a group of conditions, not an arm. \textbf  {Backward is graded by execution}: any call returning the gold value is correct, because inversion is many-to-one. $\dagger  $: format-failure rate above 0.25, mostly replies that do not meet the output contract. $\ddagger  $: above 0.25 backward, but most replies are exactly the gold \emph  {forward} answer --- the arm answered the other question, which is a result rather than a broken template. `--': not run.}}{13}{table.caption.8}\protected@file@percent }
\newlabel{tab:master_abs_codellama7b}{{6}{13}{\textbf {Every method against every obfuscation, CodeLlama-7B.} Each cell is \emph {output prediction}\,/\,\emph {input prediction}: raw exact-match accuracy on the forward task (predict the return value of the code as shown) and, after the slash, on the backward task (produce a call that returns the shown value), on the held-out programs of that condition. \emph {base} is the untuned model; \emph {ICL} its one-shot prompt; \emph {clean LoRA} is tuned on unobfuscated code; \emph {breadth} on all six training conditions pooled; \emph {anchored} is the paired-consistency objective; \emph {mixture} is the learned-gate mixture of per-transform specialists; \emph {merge} is the DARE-TIES merge of them. \textbf {Colour}: an accuracy \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt {base} in the same direction on the same condition; \texttt {base} is the reference, and an uncoloured number means no comparison was available rather than a tie. A \textcolor {red!70!black}{red number carrying $\dagger $ or $\ddagger $} is red for the other reason --- its format-failure rate is above 0.25, so the accuracy beneath it is not a fair reading of the arm --- and those cells are excluded from the bold means. \textbf {Bold rows} are means over the group named, equally weighted per condition; a superscript gives the number of readable cells averaged when it is short of the group. The family adapter (\texttt {tuned\_X1}) is deliberately not a column: it is trained on the held-out family's sibling, so on exactly the rows that matter most it is the one arm for which that family is not held out; the \textbf {held-out family} row names a group of conditions, not an arm. \textbf {Backward is graded by execution}: any call returning the gold value is correct, because inversion is many-to-one. $\dagger $: format-failure rate above 0.25, mostly replies that do not meet the output contract. $\ddagger $: above 0.25 backward, but most replies are exactly the gold \emph {forward} answer --- the arm answered the other question, which is a result rather than a broken template. `--': not run}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Every method against every obfuscation, CodeLlama-13B.} Each cell is \emph  {output prediction}\,/\,\emph  {input prediction}: raw exact-match accuracy on the forward task (predict the return value of the code as shown) and, after the slash, on the backward task (produce a call that returns the shown value), on the held-out programs of that condition. \emph  {base} is the untuned model; \emph  {ICL} its one-shot prompt; \emph  {clean LoRA} is tuned on unobfuscated code; \emph  {breadth} on all six training conditions pooled; \emph  {anchored} is the paired-consistency objective; \emph  {mixture} is the learned-gate mixture of per-transform specialists; \emph  {merge} is the DARE-TIES merge of them. \textbf  {Colour}: an accuracy \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt  {base} in the same direction on the same condition; \texttt  {base} is the reference, and an uncoloured number means no comparison was available rather than a tie. A \textcolor {red!70!black}{red number carrying $\dagger  $ or $\ddagger  $} is red for the other reason --- its format-failure rate is above 0.25, so the accuracy beneath it is not a fair reading of the arm --- and those cells are excluded from the bold means. \textbf  {Bold rows} are means over the group named, equally weighted per condition; a superscript gives the number of readable cells averaged when it is short of the group. The family adapter (\texttt  {tuned\_X1}) is deliberately not a column: it is trained on the held-out family's sibling, so on exactly the rows that matter most it is the one arm for which that family is not held out; the \textbf  {held-out family} row names a group of conditions, not an arm. \textbf  {Backward is graded by execution}: any call returning the gold value is correct, because inversion is many-to-one. $\dagger  $: format-failure rate above 0.25, mostly replies that do not meet the output contract. $\ddagger  $: above 0.25 backward, but most replies are exactly the gold \emph  {forward} answer --- the arm answered the other question, which is a result rather than a broken template. `--': not run.}}{14}{table.caption.9}\protected@file@percent }
\newlabel{tab:master_abs_codellama13b}{{7}{14}{\textbf {Every method against every obfuscation, CodeLlama-13B.} Each cell is \emph {output prediction}\,/\,\emph {input prediction}: raw exact-match accuracy on the forward task (predict the return value of the code as shown) and, after the slash, on the backward task (produce a call that returns the shown value), on the held-out programs of that condition. \emph {base} is the untuned model; \emph {ICL} its one-shot prompt; \emph {clean LoRA} is tuned on unobfuscated code; \emph {breadth} on all six training conditions pooled; \emph {anchored} is the paired-consistency objective; \emph {mixture} is the learned-gate mixture of per-transform specialists; \emph {merge} is the DARE-TIES merge of them. \textbf {Colour}: an accuracy \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt {base} in the same direction on the same condition; \texttt {base} is the reference, and an uncoloured number means no comparison was available rather than a tie. A \textcolor {red!70!black}{red number carrying $\dagger $ or $\ddagger $} is red for the other reason --- its format-failure rate is above 0.25, so the accuracy beneath it is not a fair reading of the arm --- and those cells are excluded from the bold means. \textbf {Bold rows} are means over the group named, equally weighted per condition; a superscript gives the number of readable cells averaged when it is short of the group. The family adapter (\texttt {tuned\_X1}) is deliberately not a column: it is trained on the held-out family's sibling, so on exactly the rows that matter most it is the one arm for which that family is not held out; the \textbf {held-out family} row names a group of conditions, not an arm. \textbf {Backward is graded by execution}: any call returning the gold value is correct, because inversion is many-to-one. $\dagger $: format-failure rate above 0.25, mostly replies that do not meet the output contract. $\ddagger $: above 0.25 backward, but most replies are exactly the gold \emph {forward} answer --- the arm answered the other question, which is a result rather than a broken template. `--': not run}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Every method against every obfuscation, CodeLlama-34B.} Each cell is \emph  {output prediction}\,/\,\emph  {input prediction}: raw exact-match accuracy on the forward task (predict the return value of the code as shown) and, after the slash, on the backward task (produce a call that returns the shown value), on the held-out programs of that condition. \emph  {base} is the untuned model; \emph  {ICL} its one-shot prompt; \emph  {clean LoRA} is tuned on unobfuscated code; \emph  {breadth} on all six training conditions pooled; \emph  {anchored} is the paired-consistency objective; \emph  {mixture} is the learned-gate mixture of per-transform specialists; \emph  {merge} is the DARE-TIES merge of them. \textbf  {Colour}: an accuracy \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt  {base} in the same direction on the same condition; \texttt  {base} is the reference, and an uncoloured number means no comparison was available rather than a tie. A \textcolor {red!70!black}{red number carrying $\dagger  $ or $\ddagger  $} is red for the other reason --- its format-failure rate is above 0.25, so the accuracy beneath it is not a fair reading of the arm --- and those cells are excluded from the bold means. \textbf  {Bold rows} are means over the group named, equally weighted per condition; a superscript gives the number of readable cells averaged when it is short of the group. The family adapter (\texttt  {tuned\_X1}) is deliberately not a column: it is trained on the held-out family's sibling, so on exactly the rows that matter most it is the one arm for which that family is not held out; the \textbf  {held-out family} row names a group of conditions, not an arm. \textbf  {Backward is graded by execution}: any call returning the gold value is correct, because inversion is many-to-one. $\dagger  $: format-failure rate above 0.25, mostly replies that do not meet the output contract. $\ddagger  $: above 0.25 backward, but most replies are exactly the gold \emph  {forward} answer --- the arm answered the other question, which is a result rather than a broken template. `--': not run.}}{15}{table.caption.10}\protected@file@percent }
\newlabel{tab:master_abs_codellama34b}{{8}{15}{\textbf {Every method against every obfuscation, CodeLlama-34B.} Each cell is \emph {output prediction}\,/\,\emph {input prediction}: raw exact-match accuracy on the forward task (predict the return value of the code as shown) and, after the slash, on the backward task (produce a call that returns the shown value), on the held-out programs of that condition. \emph {base} is the untuned model; \emph {ICL} its one-shot prompt; \emph {clean LoRA} is tuned on unobfuscated code; \emph {breadth} on all six training conditions pooled; \emph {anchored} is the paired-consistency objective; \emph {mixture} is the learned-gate mixture of per-transform specialists; \emph {merge} is the DARE-TIES merge of them. \textbf {Colour}: an accuracy \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt {base} in the same direction on the same condition; \texttt {base} is the reference, and an uncoloured number means no comparison was available rather than a tie. A \textcolor {red!70!black}{red number carrying $\dagger $ or $\ddagger $} is red for the other reason --- its format-failure rate is above 0.25, so the accuracy beneath it is not a fair reading of the arm --- and those cells are excluded from the bold means. \textbf {Bold rows} are means over the group named, equally weighted per condition; a superscript gives the number of readable cells averaged when it is short of the group. The family adapter (\texttt {tuned\_X1}) is deliberately not a column: it is trained on the held-out family's sibling, so on exactly the rows that matter most it is the one arm for which that family is not held out; the \textbf {held-out family} row names a group of conditions, not an arm. \textbf {Backward is graded by execution}: any call returning the gold value is correct, because inversion is many-to-one. $\dagger $: format-failure rate above 0.25, mostly replies that do not meet the output contract. $\ddagger $: above 0.25 backward, but most replies are exactly the gold \emph {forward} answer --- the arm answered the other question, which is a result rather than a broken template. `--': not run}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {Every method against every obfuscation, Llama-3.1-8B.} Each cell is \emph  {output prediction}\,/\,\emph  {input prediction}: raw exact-match accuracy on the forward task (predict the return value of the code as shown) and, after the slash, on the backward task (produce a call that returns the shown value), on the held-out programs of that condition. \emph  {base} is the untuned model; \emph  {ICL} its one-shot prompt; \emph  {clean LoRA} is tuned on unobfuscated code; \emph  {breadth} on all six training conditions pooled; \emph  {anchored} is the paired-consistency objective; \emph  {mixture} is the learned-gate mixture of per-transform specialists; \emph  {merge} is the DARE-TIES merge of them. \textbf  {Colour}: an accuracy \textcolor {green!55!black}{above} or \textcolor {red!70!black}{below} \texttt  {base} in the same direction on the same condition; \texttt  {base} is the reference, and an uncoloured number means no comparison was available rather than a tie. A \textcolor {red!70!black}{red number carrying $\dagger  $ or $\ddagger  $} is red for the other reason --- its format-failure rate is above 0.25, so the accuracy beneath it is not a fair reading of the arm --- and those cells are excluded from the bold means. \textbf  {Bold rows} are means over the group named, equally weighted per condition; a superscript gives the number of readable cells averaged when it is short of the group. The family adapter (\texttt  {tuned\_X1}) is deliberately not a column: it is trained on the held-out family's sibling, so on exactly the rows that matter most it is the one arm for which that family is not held out; the \textbf  {held-out family} row names a group of conditions, not an arm. \textbf  {Backward is graded by execution}: any call returning the gold value is correct, because inversion is many-to-one. $\dagger  $: format-failure rate above 0.25, mostly replies that do not meet the outpu