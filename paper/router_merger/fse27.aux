\newlabel{tab:merging_granite318b}{{27}{32}{\textbf {Merging, Granite-3.1-8B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {28}{\ignorespaces \textbf  {Merging, Llama-3.1-8B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid.}}{32}{table.caption.30}\protected@file@percent }
\newlabel{tab:merging_llama318b}{{28}{32}{\textbf {Merging, Llama-3.1-8B.} Weight-space merges of the per-transform specialists (TIES, DARE-TIES, DARE-linear) and two merges anchored on the clean-code adapter, on every condition and stack that has them. Same three numbers as the master grid}{table.caption.30}{}}
