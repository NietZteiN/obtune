\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces \textbf  {Every intervention against every kind of obfuscation, across the eight-model panel.} For each system and direction, $\Delta $ is the mean change in points against the untuned model and \% the mean accuracy as a percentage of the untuned model's clean-code accuracy, over the cells that exist and pass the format gate (in parentheses: the number of cells; after the semicolon, the number gated as \emph  {fmt}). Systems: ICL = \texttt  {base\_1shot}, clean LoRA = \texttt  {tuned\_L0}, breadth = \texttt  {mono\_all}, anchored = \texttt  {cons\_lam3}, family = \texttt  {tuned\_X1}. \emph  {seen} = L1b, L1r, L2, S1, S2; \emph  {seen stacks} = the six depth-2 and four depth-3/4 stacks of seen transforms; \emph  {unseen stacks} = the three depth-2 and one depth-3 stacks with the X1 family inside. Backward cells survive the gate almost only on CodeLlama-7B, whose grid (Table\nonbreakingspace \ref {tab:master_codellama7b}) is the one fully interpretable backward read; the per-model grids for the whole panel are in Appendix\nonbreakingspace \ref {app:master}.}}{16}{table.caption.15}\protected@file@percent }
\newlabel{tab:master_summary}{{13}{16}{\textbf {Every intervention against every kind of obfuscation, across the eight-model panel.} For each system and direction, $\Delta $ is the mean change in points against the untuned model and \% the mean accuracy as a percentage of the untuned model's clean-code accuracy, over the cells that exist and pass the format gate (in parentheses: the number of cells; after the semicolon, the number gated as \emph {fmt}). Systems: ICL = \texttt {base\_1shot}, clean LoRA = \texttt {tuned\_L0}, breadth = \texttt {mono\_all}, anchored = \texttt {cons\_lam3}, family = \texttt {tuned\_X1}. \emph {seen} = L1b, L1r, L2, S1, S2; \emph {seen stacks} = the six depth-2 and four depth-3/4 stacks of seen transforms; \emph {unseen stacks} = the three depth-2 and one depth-3 stacks with the X1 family inside. Backward cells survive the gate almost only on CodeLlama-7B, whose grid (Table~\ref {tab:master_codellama7b}) is the one fully interpretable backward read; the per-model grids for the whole panel are in Appendix~\ref {app:master}}{table.caption.15}{}}
