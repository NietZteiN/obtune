\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}The composition test, re-run}{9}{subsection.8.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {RQ4: the divergence ladder.} Composites that contain a transform family the model has never seen. Breadth's advantage flips sign the moment such a component enters, while anchoring rises \emph  {above} the clean-code control. The pre-registered rule required both that anchoring hold and that breadth fall below the control; only the first is established, since the pooled interval at d2 straddles zero. CodeLlama-7B, 287 programs common to all six composites, fixed before any system was evaluated.}}{9}{table.caption.5}\protected@file@percent }
\newlabel{tab:rq4_ladder}{{5}{9}{\textbf {RQ4: the divergence ladder.} Composites that contain a transform family the model has never seen. Breadth's advantage flips sign the moment such a component enters, while anchoring rises \emph {above} the clean-code control. The pre-registered rule required both that anchoring hold and that breadth fall below the control; only the first is established, since the pooled interval at d2 straddles zero. CodeLlama-7B, 287 programs common to all six composites, fixed before any system was evaluated}{table.caption.5}{}}
