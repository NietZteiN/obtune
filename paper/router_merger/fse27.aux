\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces \textbf  {Routing, CodeLlama-7B.} MoLE mixtures of the eight per-transform experts on every condition and stack that has them: \emph  {router} = trained gate, \emph  {hard router} = its argmax, \emph  {uniform} = fixed uniform gate, \emph  {random} = gate frozen at random initialisation. Per system: raw accuracy, $\Delta $ points against the untuned model on the same items, and \% of the untuned model's clean-code accuracy. Every cell ran through the mixture engine.}}{31}{table.caption.27}\protected@file@percent }
\newlabel{tab:routing_codellama7b}{{25}{31}{\textbf {Routing, CodeLlama-7B.} MoLE mixtures of the eight per-transform experts on every condition and stack that has them: \emph {router} = trained gate, \emph {hard router} = its argmax, \emph {uniform} = fixed uniform gate, \emph {random} = gate frozen at random initialisation. Per system: raw accuracy, $\Delta $ points against the untuned model on the same items, and \% of the untuned model's clean-code accuracy. Every cell ran through the mixture engine}{table.caption.27}{}}
